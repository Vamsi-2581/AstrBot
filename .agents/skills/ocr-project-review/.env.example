# Copy this file to .env in this directory. .env is gitignored.
# The endpoint may be a base URL (https://host/v1) or the full
# https://host/v1/chat/completions URL.

OCR_LLM_URL=https://your-gateway.example.com/v1
OCR_LLM_API_KEY=replace-me
OCR_LLM_MODEL=replace-me

# Optional overrides
# OCR_PROVIDER_NAME=astrbot-ocr
# OCR_REVIEW_LANGUAGE=中文
# OCR_EFFORT=medium
# OCR_CONCURRENCY=8
# OCR_TIMEOUT=15
# OCR_MAX_TOKENS_BUDGET=0
# OCR_BATCH=
# OCR_EXCLUDE=**/fixtures/*,legacy/*
# OCR_DEFAULT_EXCLUDES=1
# OCR_NPM_PACKAGE=@alibaba-group/open-code-review
# OCR_BIN=/path/to/ocr
